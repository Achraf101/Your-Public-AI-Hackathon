# Kopieer naar .env en vul in. .env wordt NOOIT gecommit.
# Geheime keys worden enkel server-side gebruikt (import-script en Supabase Edge Functions).

# --- Externe API's (enkel server-side) ---
KBO_API_TOKEN=            # CBEAPI (cbeapi.be), gratis plan 2.500 requests/dag
GOOGLE_PLACES_API_KEY=    # Google Places API (New)
JAARREKENING_API_TOKEN=   # jaarrekening.be API
# JAARREKENING_API_BASE_URL=https://jaarrekening.be/api/v1

# --- Lokale Supabase (waarden: npx supabase status -o env) — enkel voor scripts ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Kostenbeveiliging externe API-calls (harde daglimiet in de database) ---
GOOGLE_PLACES_DAILY_LIMIT=10
GOOGLE_PLACES_MONTHLY_LIMIT=900
GOOGLE_AUTO_ON_OPEN=false
KBO_API_DAILY_LIMIT=200
KBO_API_MONTHLY_LIMIT=5000
JAARREKENING_ENABLED=true
JAARREKENING_DAILY_LIMIT=60
JAARREKENING_MONTHLY_LIMIT=190
# GOOGLE_PLACES_CACHE_DAYS=7
# KBO_API_BASE_URL=https://cbeapi.be/api
