# Kopieer naar .env en vul in:  cp .env.example .env
# Gebruikt door de scripts in scripts/ en door server/index.js (Node --env-file).
# Voor de Docker-demo (docker compose up) is dit bestand NIET nodig:
# docker-compose.yml zet DATABASE_URL en PGSSLMODE zelf.

# --- Verplicht -------------------------------------------------------------
# Postgres-connectiestring. Supabase: Settings -> Database -> Connection string.
# Lokaal via docker compose: postgresql://app:local-dev-only@localhost:5432/real_businesses
DATABASE_URL=

# --- Optioneel -------------------------------------------------------------
# Zet op 'disable' voor een lokale database zonder TLS. Leeg laten bij Supabase.
PGSSLMODE=

# Poort van de REST-API (server/index.js). Default 3000.
PORT=3000

# Google Places API (New) key, enkel nodig voor `npm run verrijk`.
# Zonder deze key draait alles gewoon door op registerdata en demo-mocks.
GOOGLE_PLACES=

# Harde bovengrens op het aantal Places-calls per run. Default 50.
# Dit is de kostenbeveiliging: ook mislukte calls tellen mee.
MAX_PLACES_CALLS=50
